{
  "name": "local-review",
  "version": "0.2.0",
  "description": "Review a stack of local commits like a stack of GitHub PRs, before any of them is pushed. Comments live in plain YAML files your coding agent can read and reply to.",
  "keywords": [
    "code-review",
    "stacked-prs",
    "stacked-diffs",
    "git",
    "pull-requests",
    "ai-agents",
    "coding-agents",
    "claude-code",
    "local-first",
    "review"
  ],
  "homepage": "https://local-review.edspencer.net",
  "bugs": {
    "url": "https://github.com/edspencer/local-review/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/edspencer/local-review.git"
  },
  "license": "MIT",
  "author": "Ed Spencer",
  "type": "module",
  "bin": {
    "local-review": "dist/server/cli.js"
  },
  "files": [
    "dist/server/",
    "dist/shared/",
    "dist/web/",
    "server/fonts/",
    "examples/project.example.yaml",
    "AGENT-GUIDE.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "start": "node scripts/start.mjs",
    "build": "npm run build:web && npm run build:server",
    "build:web": "vite build",
    "build:server": "node -e \"fs.rmSync('dist/server',{recursive:true,force:true});fs.rmSync('dist/shared',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "dev": "concurrently -k -n api,web \"LOCAL_REVIEW_DEV=1 PORT=$LOCAL_REVIEW_API_PORT tsx watch server/cli.ts serve\" \"vite\"",
    "typecheck": "tsc -p tsconfig.server.json && tsc -p tsconfig.json",
    "test": "node --import tsx --test test/*.test.ts",
    "lr": "tsx server/cli.ts",
    "prepack": "npm run build",
    "smoke:pack": "node scripts/smoke-pack.mjs",
    "changeset": "changeset",
    "changeset:version": "changeset version && npm install --package-lock-only --ignore-scripts",
    "demo:seed": "tsx demo/seed.ts",
    "demo:check": "tsx demo/seed.ts check",
    "docs:media": "tsx tools/docs-media/capture.ts",
    "docs:media:gif": "tsx tools/docs-media/gif.ts",
    "docs:media:sync": "tsx tools/docs-media/sync.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.4",
    "@resvg/resvg-js": "^2.6.2",
    "chokidar": "^5.0.0",
    "hono": "^4.13.13",
    "opentype.js": "^2.0.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@pierre/diffs": "1.5.2",
    "@types/node": "^26.6.4",
    "@types/opentype.js": "^1.3.10",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "dompurify": "^3.4.16",
    "marked": "^18.1.0",
    "playwright": "^1.64.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
