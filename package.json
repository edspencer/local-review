{
  "name": "local-review",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node scripts/start.mjs",
    "build": "vite build",
    "dev": "concurrently -k -n api,web \"LOCAL_REVIEW_DEV=1 PORT=${LOCAL_REVIEW_API_PORT:-5001} tsx watch server/index.ts\" \"vite\"",
    "typecheck": "tsc -p tsconfig.server.json && tsc -p tsconfig.json",
    "test": "node --import tsx --test test/*.test.ts",
    "lr": "tsx server/cli.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.4",
    "@pierre/diffs": "1.5.2",
    "@resvg/resvg-js": "^2.6.2",
    "chokidar": "^5.0.0",
    "dompurify": "^3.4.16",
    "hono": "^4.13.13",
    "marked": "^18.1.0",
    "opentype.js": "^2.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/opentype.js": "^1.3.10",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
