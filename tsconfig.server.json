{
  "compilerOptions": {
    "target": "ES2023",
    "lib": [
      "ES2023"
    ],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "node"
    ],
    "allowImportingTsExtensions": true
  },
  "include": [
    "server",
    "shared",
    "test",
    "demo",
    "tools"
  ],
  "exclude": [
    "demo/out",
    "tools/docs-media/out"
  ]
}
