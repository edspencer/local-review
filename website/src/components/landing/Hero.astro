---
/**
 * Hero — the fold.
 *
 * Two columns on desktop, as on Paddock's site: prose and buttons on the left,
 * the terminal card on the right. Under the terminal, where Paddock has its
 * video, is ours: one review round trip, 16 seconds, muted and looping (the
 * capture rig's gif.ts, on the fictional demo project). It plays only while on
 * screen, and not at all with reduced motion, which gets the poster and the
 * controls instead (heroVideo() in scripts/landing.ts). Width and height are
 * set, so nothing shifts when it loads. On mobile the columns stack.
 */
import { getImage } from 'astro:assets';
import Icon from './Icon.astro';
import CommandTabs from './CommandTabs.astro';
import HeroBackdrop from './HeroBackdrop.astro';
import { hero, HERO_LINKS } from './copy';
import demoPoster from '../../assets/landing/demo-poster.png';

// The video's first frame, optimised: what shows until it plays, and instead of it with reduced motion. Its size
// (2x, like every capture) gives the <video> its aspect ratio, so the space is reserved before anything loads.
const poster = await getImage({ src: demoPoster, width: 1200, format: 'webp', quality: 80 });
---

<section class="hero">
	<HeroBackdrop />

	<div class="container hero-inner">
		<div class="hero-copy">
			<p class="eyebrow">{hero.eyebrow}</p>
			<h1 class="h1">{hero.title}</h1>
			<p class="lede lede--first">{hero.lede}</p>
			<p class="lede">{hero.body}</p>

			<div class="btn-row hero-btns">
				{
					HERO_LINKS.map((l) => (
						<a
							class={`btn ${l.primary ? 'btn--primary' : ''}`}
							href={l.href}
							rel={l.href.startsWith('http') ? 'noopener' : undefined}
						>
							<Icon name={l.icon as any} />
							{l.text}
						</a>
					))
				}
			</div>
		</div>

		<div class="hero-aside">
			<CommandTabs idPrefix="hero" />

			<video
				class="hero-video"
				src="/demo/demo.mp4"
				poster={poster.src}
				width={demoPoster.width / 2}
				height={demoPoster.height / 2}
				muted
				loop
				playsinline
				preload="none"
				aria-label="Local Review on a fictional demo project: the reviewer comments on a range of lines, the agent's reply appears in the thread, the reviewer resolves it and marks the PR ready, and the sidebar's stack tally moves on"
				data-hero-video
			></video>
		</div>
	</div>
</section>

<style>
	.hero {
		position: relative;
		display: flex;
		align-items: center;
		/* Not 100svh. A full-viewport hero on a 900px-tall laptop left ~150px of
		   dead space above and below the content, which reads as a layout bug
		   rather than as generosity. This is tall enough to own the fold and
		   short enough that the next section peeks, which is what invites the
		   scroll the whole page depends on. */
		min-height: min(92svh, 54rem);
		padding-block: 8rem 4.5rem;
		isolation: isolate;
	}

	.hero-inner {
		position: relative;
		z-index: 1;
		display: grid;
		gap: clamp(2.5rem, 5vw, 4rem);
		align-items: center;
	}

	@media (min-width: 940px) {
		.hero-inner {
			/* Even halves (Paddock uses 47/53), plus slightly tighter button padding
			   below: together they keep our three hero buttons on one row at
			   1440px, where 47fr left them ~30px short. */
			grid-template-columns: 1fr 1fr;
		}
	}

	/* Smaller than the shared .h1: our headline is a whole sentence, and at
	   full size it ran to four lines and pushed the buttons below the fold. */
	.hero-copy .h1 {
		font-size: clamp(2.4rem, 5vw, 3.6rem);
		margin-bottom: 1.6rem;
	}

	.lede--first {
		margin-top: 0;
	}

	.lede + .lede {
		margin-top: 1rem;
	}

	.hero-btns {
		margin-top: 2.25rem;
	}

	.hero-btns .btn {
		padding-inline: 1.1rem;
	}

	.hero-aside {
		display: flex;
		flex-direction: column;
		gap: 1.1rem;
		min-width: 0;
	}

	.hero-video {
		display: block;
		width: 100%;
		height: auto;
		border: 1px solid var(--border-subtle);
		border-radius: var(--radius-media);
		background: var(--sunken);
		box-shadow: 0 24px 60px -20px rgb(0 0 0 / 0.7);
	}

</style>
