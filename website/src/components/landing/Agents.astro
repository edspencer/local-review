---
/**
 * Agents — the "works with your agent" section.
 *
 * Prose and three short points on the left; on the right, a review file as an
 * agent sees it, so the claim "plain files in, plain files out" is shown rather
 * than asserted. The sample in copy.ts follows the real schema (README
 * "Comment files") but is illustrative, not captured data.
 */
import Icon from './Icon.astro';
import { AGENTS } from './copy';

/** `like this` → <code>like this</code>. The copy is ours, so no escaping beyond the basics. */
const inlineCode = (text: string) =>
	text
		.replace(/&/g, '&amp;')
		.replace(/</g, '&lt;')
		.replace(/`([^`]+)`/g, '<code>$1</code>');

/** Tint the YAML keys and the two authors, without pulling in a highlighter. */
const highlighted = AGENTS.sample
	.split('\n')
	.map((line) =>
		line
			.replace(/&/g, '&amp;')
			.replace(/</g, '&lt;')
			.replace(/^(\s*-?\s*)([a-z_]+):/, '$1<span class="k">$2</span>:')
			.replace(/(author<\/span>: )(claude)$/, '$1<span class="a-agent">$2</span>')
			.replace(/(author<\/span>: )(ada)$/, '$1<span class="a-you">$2</span>'),
	)
	.join('\n');
---

<section class="agents section">
	<div class="container agents-inner">
		<div class="agents-copy" data-reveal>
			<p class="eyebrow">{AGENTS.eyebrow}</p>
			<h2 class="h2">{AGENTS.title}</h2>
			<p class="lede">{AGENTS.body}</p>

			<ul class="points">
				{
					AGENTS.points.map((p) => (
						<li>
							<span class="tick">
								<Icon name="check" />
							</span>
							<div>
								<h3>{p.title}</h3>
								<p set:html={inlineCode(p.body)} />
							</div>
						</li>
					))
				}
			</ul>

			<a class="more" href={AGENTS.link.href}>
				{AGENTS.link.text} <span aria-hidden="true">→</span>
			</a>
		</div>

		<figure class="file" data-reveal>
			<figcaption class="file-bar">
				<span class="file-name">~/.local-review/…/my-feature/{AGENTS.file}</span>
			</figcaption>
			<pre class="file-body"><code set:html={highlighted} /></pre>
		</figure>
	</div>
</section>

<style>
	.agents {
		border-top: 1px solid var(--border-subtle);
	}

	.agents-inner {
		display: grid;
		gap: clamp(2.5rem, 5vw, 4rem);
		align-items: center;
	}

	@media (min-width: 940px) {
		.agents-inner {
			grid-template-columns: 1fr 1fr;
		}
	}

	.agents-copy .lede {
		margin-top: 1.1rem;
	}

	.points {
		list-style: none;
		margin: 2rem 0 0;
		padding: 0;
		display: grid;
		gap: 1.25rem;
	}

	.points li {
		display: flex;
		gap: 0.9rem;
	}

	.tick {
		flex: none;
		display: grid;
		place-items: center;
		width: 24px;
		height: 24px;
		margin-top: 0.1rem;
		border-radius: 50%;
		background: color-mix(in oklab, rgb(var(--accent)) 18%, transparent);
		color: rgb(var(--accent));
	}

	.tick :global(svg) {
		width: 14px;
		height: 14px;
	}

	.points h3 {
		margin: 0 0 0.25rem;
		font-size: 1rem;
		font-weight: 600;
	}

	.points p {
		margin: 0;
		color: var(--text-muted);
		font-size: 0.95rem;
		line-height: 1.6;
	}

	.points :global(code),
	.file-name {
		font-family: var(--font-mono);
		font-size: 0.85em;
	}

	.points :global(code) {
		padding: 0.1em 0.35em;
		border-radius: 5px;
		background: var(--raised);
		color: var(--text);
	}

	.more {
		display: inline-flex;
		gap: 0.35rem;
		margin-top: 2rem;
		color: rgb(var(--accent));
		font-weight: 500;
		text-decoration: none;
	}

	.more:hover {
		text-decoration: underline;
		text-underline-offset: 3px;
	}

	.file {
		margin: 0;
		min-width: 0;
		border: 1px solid var(--border-subtle);
		border-radius: var(--radius-media);
		background: var(--sunken);
		box-shadow: 0 24px 60px -20px rgb(0 0 0 / 0.7);
		overflow: hidden;
	}

	/* The file bar is the app's own top bar in miniature: plum, amber underline. */
	.file-bar {
		padding: 0.65rem 1rem;
		background: linear-gradient(90deg, var(--plum) 0%, var(--plum-2) 100%);
		border-bottom: 2px solid rgb(var(--accent));
		overflow-x: auto;
		white-space: nowrap;
	}

	.file-name {
		color: rgb(255 255 255 / 0.85);
	}

	.file-body {
		margin: 0;
		padding: 1.1rem 1.25rem 1.3rem;
		font-family: var(--font-mono);
		font-size: 0.84rem;
		line-height: 1.7;
		color: var(--text);
		overflow-x: auto;
	}

	.file-body :global(.k) {
		color: var(--text-subtle);
	}

	.file-body :global(.a-you) {
		color: #8cc8ff;
	}

	/* The app marks agent comments in Claude's terracotta (--claude, #c15f3c). */
	.file-body :global(.a-agent) {
		color: #e58a66;
	}
</style>
