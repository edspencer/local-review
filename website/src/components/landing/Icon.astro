---
/**
 * The handful of inline icons the landing page needs. Inline rather than an
 * icon package: it's a dozen glyphs, they must inherit `currentColor` inside
 * buttons, and a dependency for that would be silly.
 */
interface Props {
	name:
		| 'github'
		| 'docs'
		| 'play'
		| 'copy'
		| 'check'
		| 'arrow'
		| 'stack'
		| 'repos'
		| 'chat'
		| 'lock'
		| 'shield'
		| 'rocket'
		| 'image';
	class?: string;
}
const { name, class: className } = Astro.props;
---

<svg
	class={className}
	viewBox="0 0 24 24"
	fill="none"
	stroke="currentColor"
	stroke-width="1.8"
	stroke-linecap="round"
	stroke-linejoin="round"
	aria-hidden="true"
	focusable="false"
>
	{
		name === 'github' && (
			<path
				fill="currentColor"
				stroke="none"
				d="M12 .5A11.5 11.5 0 0 0 .5 12a11.5 11.5 0 0 0 7.86 10.92c.58.1.79-.25.79-.55v-2.1c-3.2.7-3.88-1.37-3.88-1.37-.53-1.34-1.29-1.7-1.29-1.7-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.2 1.77 1.2 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.7 0-1.26.45-2.29 1.19-3.1-.12-.3-.52-1.47.11-3.05 0 0 .97-.31 3.18 1.18a11 11 0 0 1 5.8 0c2.2-1.5 3.17-1.18 3.17-1.18.63 1.58.23 2.75.12 3.04.74.82 1.18 1.85 1.18 3.11 0 4.43-2.69 5.4-5.25 5.69.41.36.78 1.06.78 2.14v3.17c0 .3.2.66.8.55A11.5 11.5 0 0 0 23.5 12 11.5 11.5 0 0 0 12 .5Z"
			/>
		)
	}
	{
		name === 'docs' && (
			<>
				<path d="M4 5.5A1.5 1.5 0 0 1 5.5 4H10a2 2 0 0 1 2 2v13a2 2 0 0 0-2-2H5.5A1.5 1.5 0 0 1 4 15.5Z" />
				<path d="M20 5.5A1.5 1.5 0 0 0 18.5 4H14a2 2 0 0 0-2 2v13a2 2 0 0 1 2-2h4.5a1.5 1.5 0 0 0 1.5-1.5Z" />
			</>
		)
	}
	{
		name === 'play' && (
			<path fill="currentColor" stroke="none" d="M8 5.5v13l11-6.5-11-6.5Z" />
		)
	}
	{
		name === 'copy' && (
			<>
				<rect x="9" y="9" width="11" height="11" rx="2" />
				<path d="M5 15V6a2 2 0 0 1 2-2h8" />
			</>
		)
	}
	{name === 'check' && <path d="m5 12.5 4.5 4.5L19 7" />}
	{name === 'arrow' && <path d="M5 12h13m-5-6 6 6-6 6" />}
	{
		name === 'stack' && (
			<>
				<rect x="4" y="4" width="16" height="4.5" rx="1.5" />
				<rect x="4" y="10.5" width="16" height="4.5" rx="1.5" />
				<rect x="4" y="17" width="10" height="3.5" rx="1.5" />
			</>
		)
	}
	{
		name === 'repos' && (
			<>
				<circle cx="6" cy="6" r="2.2" />
				<circle cx="6" cy="18" r="2.2" />
				<circle cx="18" cy="9" r="2.2" />
				<path d="M6 8.2v7.6M18 11.2c0 3.5-5 3-10.2 5.4" />
			</>
		)
	}
	{name === 'chat' && <path d="M5 5h14a1.5 1.5 0 0 1 1.5 1.5v9A1.5 1.5 0 0 1 19 17h-8l-4.5 3.5V17H5a1.5 1.5 0 0 1-1.5-1.5v-9A1.5 1.5 0 0 1 5 5Z" />}
	{
		name === 'lock' && (
			<>
				<rect x="5" y="10.5" width="14" height="10" rx="2" />
				<path d="M8.5 10.5V7.5a3.5 3.5 0 0 1 7 0v3" />
			</>
		)
	}
	{
		name === 'shield' && (
			<>
				<path d="M12 3.5 19 6v5.5c0 4.3-2.9 7.6-7 9-4.1-1.4-7-4.7-7-9V6Z" />
				<path d="m9 12 2.2 2.2L15.5 10" />
			</>
		)
	}
	{
		name === 'rocket' && (
			<>
				<path d="M14 4.5c3-1 5.5-1 5.5-1s0 2.5-1 5.5L13 14.5 9.5 11Z" />
				<path d="M9.5 11 6 10.5 8.5 8h4M13 14.5l.5 3.5 2.5-2.5v-4" />
				<path d="M7 15.5c-1.5.5-2.5 2.5-2.5 4 1.5 0 3.5-1 4-2.5" />
			</>
		)
	}
	{
		name === 'image' && (
			<>
				<rect x="3.5" y="4.5" width="17" height="15" rx="2" />
				<circle cx="9" cy="10" r="1.8" />
				<path d="m20.5 16-5-5-9 8.5" />
			</>
		)
	}
</svg>
